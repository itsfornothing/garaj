{
  "name": "garaj-api",
  "version": "0.1.0",
  "private": true,
  "description": "GarAj business backend — Fastify owns authorization, transactions, payments, background jobs (brief §4a: no business logic in edge functions)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --import tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "fastify": "^5.6.0",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.7.0"
  }
}
